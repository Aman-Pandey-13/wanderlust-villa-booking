<% layout("/layout/boilerplate") -%>
<div class="container mt-4">
    <h3>Search Results for "<%= query %>"</h3>
    <hr>

    <% if (results.length===0) { %>
        <p>No villas found for your search.</p>
        <% } else { %>
            <div class="row">
                <% results.forEach(listing=> { %>
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <img src="<%= listing.images[0]?.url || '/images/default.jpg' %>" class="card-img-top"
                                alt="<%= listing.title %>">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <%= listing.title %>
                                </h5>
                                <p class="card-text">
                                    <%= listing.location %>, <%= listing.country %>
                                </p>
                                <a href="/listings/<%= listing._id %>" class="btn btn-dark">View Details</a>
                            </div>
                        </div>
                    </div>
                    <% }) %>
            </div>
            <% } %>
</div>
