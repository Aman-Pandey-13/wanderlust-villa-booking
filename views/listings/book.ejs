<% layout("/layout/boilerplate") -%>

  <!-- CSS / libs -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/airbnb.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

  <style>
    body {
      background: #f6f7fb;
    }

    .container {
      max-width: 1100px;
    }

    /* Progress bar */
    .stepper {
      display: flex;
      gap: 12px;
      align-items: center;
      margin-bottom: 24px;
    }

    .step {
      flex: 1;
      text-align: center;
      position: relative;
    }

    .step-line {
      position: absolute;
      left: 0;
      right: 0;
      top: 18px;
      height: 3px;
      background: #e9ecef;
      z-index: 0;
    }

    .step:first-child .step-line {
      display: none;
    }

    .circle {
      z-index: 1;
      width: 36px;
      height: 36px;
      margin: 0 auto 8px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e9ecef;
      color: #495057;
      font-weight: 600;
    }

    .step.active .circle {
      background: #0d6efd;
      color: #fff;
    }

    .step.completed .circle {
      background: #198754;
      color: #fff;
    }

    .step p {
      margin: 0;
      font-size: 0.9rem;
      color: #6c757d;
    }

    /* cards */
    .card-custom {
      border-radius: 14px;
      padding: 22px;
      background: #fff;
      box-shadow: 0 6px 18px rgba(15, 15, 15, 0.04);
      margin-bottom: 18px;
    }

    .summary-card {
      position: sticky;
      top: 90px;
    }

    /* option card */
    .option-card {
      border-radius: 10px;
      padding: 12px;
      border: 1px solid #e9ecef;
      cursor: pointer;
      margin-bottom: 12px;
      background: #fff;
    }

    .option-card.active {
      border-color: #0d6efd;
      background: #eef5ff;
      box-shadow: 0 6px 18px rgba(13, 110, 253, 0.06);
    }

    .option-card h6 {
      margin: 0;
      font-weight: 600;
    }

    .option-card small {
      color: #6c757d;
      display: block;
      margin-top: 6px;
    }

    .option-date {
      margin-top: 8px;
    }

    /* flatpickr tweaks */
    .flatpickr-calendar {
      border-radius: 10px !important;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08) !important;
    }

    .flatpickr-day.startRange,
    .flatpickr-day.endRange,
    .flatpickr-day.selected {
      background: #0d6efd !important;
      color: #fff !important;
      border-radius: 6px !important;
    }
  </style>

  <div class="container my-5">
    <h2 class="mb-3 text-center">Book — <%= listing.title %>
    </h2>

    <!-- Progress bar -->
    <div class="stepper">
      <div class="step active" data-step="1" id="stepIndicator-1">
        <div class="step-line"></div>
        <div class="circle">1</div>
        <p>Dates</p>
      </div>
      <div class="step" data-step="2" id="stepIndicator-2">
        <div class="step-line"></div>
        <div class="circle">2</div>
        <p>Guests</p>
      </div>
      <div class="step" data-step="3" id="stepIndicator-3">
        <div class="step-line"></div>
        <div class="circle">3</div>
        <p>Specials & Events</p>
      </div>
      <div class="step" data-step="4" id="stepIndicator-4">
        <div class="step-line"></div>
        <div class="circle">4</div>
        <p>Summary</p>
      </div>
      <div class="step" data-step="5" id="stepIndicator-5">
        <div class="step-line"></div>
        <div class="circle">5</div>
        <p>Payment</p>
      </div>
    </div>

    <div class="row gx-4">
      <!-- Left: content -->
      <div class="col-md-8">

        <form id="bookingForm" action="/listings/<%= listing._id %>/book" method="POST">

          <!-- Step 1: Dates -->
          <div class="card-custom step-content" data-step="1">
            <label class="form-label fw-bold">Select Check-in & Check-out Dates</label>
            <input type="text" id="dateRange" name="dateRange" placeholder="Select date range" required>
            <div class="d-flex justify-content-between">
              <div></div>
              <div class="mt-3">
                <button type="button" id="checkAvailabilityBtn" class="btn btn-outline-primary">
                  Check Availability
                </button>
                <span id="availabilityMsg" class="ms-2"></span>
              </div>

              <button type="button" class="btn btn-primary next-btn" data-next="2">Next</button>
            </div>
          </div>

          <!-- Step 2: Guests -->
          <div class="card-custom step-content d-none" data-step="2">
            <h5 class="mb-3">Guests</h5>
            <% const guestLimits={ Adults: 5, Children: 5, Infants: 3, Pets: 3 }; %>
              <% Object.entries(guestLimits).forEach(([type, limit])=> { %>
                <div class="d-flex justify-content-between align-items-center mb-3">
                  <div><strong>
                      <%= type %>
                    </strong> <small class="text-muted">(max <%= limit %>)</small></div>
                  <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm guest-btn"
                      data-field="<%= type.toLowerCase() %>" data-change="-1" data-limit="<%= limit %>">−</button>
                    <input type="number" id="<%= type.toLowerCase() %>" name="<%= type.toLowerCase() %>"
                      value="<%= type==='Adults'?1:0 %>" min="0" class="form-control text-center" style="width:70px"
                      readonly>
                    <button type="button" class="btn btn-outline-secondary btn-sm guest-btn"
                      data-field="<%= type.toLowerCase() %>" data-change="1" data-limit="<%= limit %>">+</button>
                  </div>
                </div>
                <% }) %>
                  <div class="d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary prev-btn" data-prev="1">Back</button>
                    <button type="button" class="btn btn-primary next-btn" data-next="3">Next</button>
                  </div>
          </div>

          <!-- Step 3: Specials & Events -->
          <div class="card-custom step-content d-none" data-step="3">
            <div class="mb-4">
              <h5 class="mb-2">✨ Make Your Stay Special</h5>
              <div id="specials-container">
                <div class="option-card none-option" data-id="none-special" data-price="0">
                  <h6>None</h6>
                  <small>No extras</small>
                </div>
                <% const specials=[ { id: "pool" , label: "Pool Party" , desc: "Music, drinks & pool" , price: 1000 }, {
                  id: "dj" , label: "DJ Night" , desc: "Private DJ experience" , price: 3000 }, { id: "dinner" ,
                  label: "Candlelight Dinner" , desc: "Romantic dinner setup" , price: 1200 }, { id: "spa" ,
                  label: "Spa Setup" , desc: "In-room spa" , price: 1500 } ]; %>
                  <% specials.forEach(s=> { %>
                    <div class="option-card" data-id="<%= s.id %>" data-price="<%= s.price %>">
                      <h6>
                        <%= s.label %> (+₹<%= s.price %>)
                      </h6>
                      <small>
                        <%= s.desc %>
                      </small>
                      <input type="text" class="form-control option-date hidden mt-2" data-for="<%= s.id %>"
                        placeholder="Select date" readonly>
                    </div>
                    <% }) %>
              </div>
            </div>

            <div>
              <h5 class="mb-2">🎉 Free Events</h5>
              <div id="events-container">
                <div class="option-card none-option" data-id="none-event" data-price="0">
                  <h6>None</h6>
                  <small>No events</small>
                </div>
                <% const events=[ { id: "pottery" , label: "Pottery" , desc: "Clay workshop" }, { id: "games" ,
                  label: "Games" , desc: "Indoor & outdoor games" }, { id: "yoga" , label: "Yoga Session" ,
                  desc: "Morning yoga" }, { id: "cooking" , label: "Cooking Class" , desc: "Local recipes" }, {
                  id: "tour" , label: "Local Tour" , desc: "Guided city walk" }, { id: "bonfire" , label: "Bonfire" ,
                  desc: "Evening bonfire" } ]; %>
                  <% events.forEach(e=> { %>
                    <div class="option-card" data-id="<%= e.id %>" data-price="0">
                      <h6>
                        <%= e.label %>
                      </h6>
                      <small>
                        <%= e.desc %>
                      </small>
                      <input type="text" class="form-control option-date hidden mt-2" data-for="<%= e.id %>"
                        placeholder="Select date" readonly>
                    </div>
                    <% }) %>
              </div>
            </div>

            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-secondary prev-btn" data-prev="2">Back</button>
              <button type="button" class="btn btn-primary next-btn" data-next="4">Next</button>
            </div>
          </div>
          <!-- Step 4: Review / Summary -->
          <div class="card-custom step-content d-none" data-step="4">
            <h5 class="mb-3">Review Your Trip</h5>
            <div id="summaryContent"></div>
            <div class="d-flex justify-content-between mt-3">
              <button type="button" class="btn btn-secondary prev-btn" data-prev="3">Back</button>
              <button type="button" class="btn btn-success next-btn" data-next="5">Proceed to
                Payment</button>
            </div>
          </div>

          <!-- Step 5: Payment -->
          <!-- Step 5: Payment -->
          <div class="card-custom step-content d-none" data-step="5">
            <h5 class="mb-3">Payment</h5>
            <p>Scan the QR code below or choose Cash on Arrival.</p>

            <!-- UPI QR Code -->
            <div class="text-center mb-3">
              <img src="/images/upi-qr.png" alt="UPI QR Code" class="img-fluid" style="max-width:200px;">
              <p class="mt-2 text-muted">Scan to pay via UPI</p>
            </div>

            <!-- Payment Options -->
            <div class="d-flex flex-column gap-2">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="paymentMethod" id="upi" value="UPI" checked>
                <label class="form-check-label" for="upi">UPI Payment</label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="paymentMethod" id="cash" value="Cash">
                <label class="form-check-label" for="cash">Cash on Arrival</label>
              </div>
            </div>

            <div class="mt-3 d-flex justify-content-between">
              <button type="button" class="btn btn-secondary prev-btn" data-prev="4">Back</button>
              <button type="submit" id="confirmBookingBtn" class="btn btn-primary">Confirm Booking</button>
            </div>
          </div>

        </form>
      </div>

      <!-- Right: live summary -->
      <div class="col-md-4">
        <div class="card-custom summary-card">
          <h5 class="text-center mb-3">Your Trip Summary</h5>
          <div id="liveSummary">Loading...</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bootstrap + Flatpickr scripts -->
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

