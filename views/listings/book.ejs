  <script>
    (function () {
      // Globals
      const PRICE_PER_NIGHT = parseInt("<%= listing.price || 2000 %>", 10);
      let checkIn = null, checkOut = null;

      // Stepper helpers
      const stepIndicators = document.querySelectorAll('.step');
      function setActiveStep(n) {
        stepIndicators.forEach(el => {
          el.classList.remove('active', 'completed');
          const s = parseInt(el.dataset.step, 10);
          if (s < n) el.classList.add('completed');
          if (s === n) el.classList.add('active');
        });
        // show/hide step contents
        document.querySelectorAll('.step-content').forEach(c => c.classList.add('d-none'));
        const show = document.querySelector('.step-content[data-step="' + n + '"]');
        if (show) show.classList.remove('d-none');
      }

      // init page at step 1
      setActiveStep(1);

      // Next / Prev buttons
      document.querySelectorAll('.next-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const next = parseInt(btn.dataset.next, 10);
          const current = getCurrentStep();

          // Step 1: Dates - prevent going next if not available
          if (current === 1) {
            if (!checkIn || !checkOut) {
              alert("Please select check-in and check-out dates.");
              return;
            }

            if (!isAvailable) {
              alert("🚫 This villa is already booked for those dates. Please select different dates.");
              return;
            }
          }

          if (!validateStep(current)) return;
          updateSummaryContent();
          setActiveStep(next);
          if (next === 3) initOptionDatePickers();
        });
      });

      document.querySelectorAll('.prev-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const prev = parseInt(btn.dataset.prev, 10);
          setActiveStep(prev);
        });
      });

      // determine current step index
      function getCurrentStep() {
        for (const el of document.querySelectorAll('.step')) if (el.classList.contains('active')) return parseInt(el.dataset.step, 10);
        return 1;
      }

      // Validate per-step
      function validateStep(step) {
        if (step === 1) {
          if (!checkIn || !checkOut) { alert("Please select check-in and check-out dates."); return false; }
          return true;
        }
        if (step === 2) {
          const adults = parseInt(document.getElementById('adults').value, 10);
          if (!adults || adults < 1) { alert("At least 1 adult required."); return false; }
          return true;
        }
        if (step === 3) {
          // if any option-card active (except none-option), ensure its date is filled
          const activeCards = Array.from(document.querySelectorAll('#specials-container .option-card.active, #events-container .option-card.active'))
            .filter(c => !c.classList.contains('none-option'));
          for (const c of activeCards) {
            const input = c.querySelector('.option-date');
            if (input && !input.value) { alert("Please select date for selected specials/events."); return false; }
          }
          return true;
        }
        return true;
      }

      // FLATPICKR: main calendar (inline, 2 months)
      flatpickr("#dateRange", {
        mode: "range",
        minDate: "today",
        dateFormat: "Y-m-d",
        inline: true,
        showMonths: 2,
        onChange: function (selectedDates) {
          if (selectedDates.length === 2) {
            checkIn = selectedDates[0];
            checkOut = selectedDates[1];
          } else {
            checkIn = null; checkOut = null;
          }
          updateSummaryContent();
          // update any open option-date pickers min/max
          updateOptionDatePickersRange();
        }
      });

      // Guest buttons
      document.querySelectorAll('.guest-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const field = btn.dataset.field;
          const change = parseInt(btn.dataset.change, 10);
          const limit = parseInt(btn.dataset.limit, 10);
          const input = document.getElementById(field);
          let val = parseInt(input.value, 10) + change;
          if (val < 0) val = 0;
          if (val > limit) val = limit;
          input.value = val;
          updateSummaryContent();
        });
      });

      // Option-card click handling with 'None' mutual exclusion
      function wireOptionCards(containerSelector, noneClassId) {
        const container = document.querySelector(containerSelector);
        if (!container) return;
        container.querySelectorAll('.option-card').forEach(card => {
          card.addEventListener('click', () => {
            const isNone = card.classList.contains('none-option');
            const cards = container.querySelectorAll('.option-card');
            if (isNone) {
              // activate this none and deactivate others
              cards.forEach(c => {
                c.classList.remove('active');
                const inp = c.querySelector('.option-date');
                if (inp) { inp.classList.add('hidden'); inp.value = ""; }
              });
              card.classList.add('active');
            } else {
              // toggle this, and deactivate the none-option
              card.classList.toggle('active');
              const none = container.querySelector('.none-option');
              if (none) none.classList.remove('active');
              const inp = card.querySelector('.option-date');
              if (card.classList.contains('active')) {
                if (inp) { inp.classList.remove('hidden'); initializeOrUpdatePicker(inp); }
              } else {
                if (inp) { inp.classList.add('hidden'); inp.value = ""; }
              }
            }
            updateSummaryContent();
          });
        });
      }
      wireOptionCards('#specials-container');
      wireOptionCards('#events-container');

      // Option date pickers initialization / update
      function initializeOrUpdatePicker(input) {
        // if flatpickr instance exists, update range; else init
        if (input._flatpickr) {
          input._flatpickr.set('minDate', checkIn || 'today');
          input._flatpickr.set('maxDate', checkOut || null);
        } else {
          flatpickr(input, { dateFormat: "Y-m-d", minDate: checkIn || 'today', maxDate: checkOut || null });
        }
      }
      function initOptionDatePickers() {
        document.querySelectorAll('.option-date').forEach(input => {
          if (!input.classList.contains('hidden')) initializeOrUpdatePicker(input);
        });
      }
      function updateOptionDatePickersRange() {
        document.querySelectorAll('.option-date').forEach(input => {
          if (input._flatpickr) {
            input._flatpickr.set('minDate', checkIn || 'today');
            input._flatpickr.set('maxDate', checkOut || null);
          }
        });
      }

      // Summary content (both right panel and step 4 review)
      function updateSummaryContent() {
        const nights = calculateNights();
        const adults = parseInt(document.getElementById('adults').value, 10) || 0;
        const children = parseInt(document.getElementById('children').value, 10) || 0;
        const infants = parseInt(document.getElementById('infants').value, 10) || 0;
        const pets = parseInt(document.getElementById('pets').value, 10) || 0;

        // base price
        const baseTotal = PRICE_PER_NIGHT * nights;

        // extras (specials only have price)
        let extras = 0;
        let specialsHTML = '';
        let eventsHTML = '';   // <-- FIX: Initialize this variable

        document.querySelectorAll('#specials-container .option-card.active').forEach(card => {
          if (card.classList.contains('none-option')) return;
          const price = parseInt(card.dataset.price || 0);
          const label = card.querySelector('h6').innerText;
          const dateVal = (card.querySelector('.option-date') || {}).value || 'No date';
          extras += price;
          specialsHTML += `<li>${label} — ${dateVal} — ₹${price}</li>`;
        });

        document.querySelectorAll('#events-container .option-card.active').forEach(card => {
          if (card.classList.contains('none-option')) return;
          const label = card.querySelector('h6').innerText;
          const dateVal = (card.querySelector('.option-date') || {}).value || 'No date';
          eventsHTML += `<li>${label} — ${dateVal}</li>`;
        });

        const gst = Math.round((baseTotal + extras) * 0.18);
        const total = baseTotal + extras + gst;

        const summaryHtml = `
      <p><strong>Check-in:</strong> ${checkIn ? formatDate(checkIn) : '—'}</p>
      <p><strong>Check-out:</strong> ${checkOut ? formatDate(checkOut) : '—'}</p>
      <p><strong>Nights:</strong> ${nights}</p>
      <hr>
      <p><strong>Guests:</strong></p>
      <ul class="small">
        <li>Adults: ${adults}</li>
        <li>Children: ${children}</li>
        <li>Infants: ${infants}</li>
        <li>Pets: ${pets}</li>
      </ul>
      <hr>
      <p><strong>Specials</strong></p>
      <ul class="small">${specialsHTML || '<li>None</li>'}</ul>
      <p><strong>Events</strong></p>
      <ul class="small">${eventsHTML || '<li>None</li>'}</ul>
      <hr>
      <p><strong>Pricing</strong></p>
      <div class="d-flex justify-content-between"><div>₹${PRICE_PER_NIGHT} × ${nights} nights</div><div>₹${baseTotal}</div></div>
      <div class="d-flex justify-content-between"><div>Extras</div><div>₹${extras}</div></div>
      <div class="d-flex justify-content-between"><div>GST (18%)</div><div>₹${gst}</div></div>
      <div class="d-flex justify-content-between mt-2"><div><strong>Total</strong></div><div><strong>₹${total}</strong></div></div>
    `;

        // update right panel and review step
        document.getElementById('liveSummary').innerHTML = summaryHtml;
        const sc = document.getElementById('summaryContent');
        if (sc) sc.innerHTML = summaryHtml;
      }

      // Helper: calculate nights
      function calculateNights() {
        if (!checkIn || !checkOut) return 0;
        const ms = 1000 * 60 * 60 * 24;
        return Math.round((checkOut - checkIn) / ms);
      }
      function formatDate(d) {
        if (!d || isNaN(new Date(d).getTime())) return '';
        const dateObj = new Date(d);
        return dateObj.toISOString().split('T')[0];
      }


      // initial update
      updateSummaryContent();

      // Also update summary when option-date inputs change
      document.addEventListener('change', function (e) {
        if (e.target && e.target.classList && e.target.classList.contains('option-date')) {
          updateSummaryContent();
        }
      });

      // make sure step indicators clickable (jump)
      document.querySelectorAll('.step').forEach(ind => {
        ind.addEventListener('click', () => {
          const step = parseInt(ind.dataset.step, 10);
          // only allow jumping to steps <= currentCompleted+1
          // But for simplicity allow jump but validate on next/submit
          setActiveStep(step);
        });
      });

      // expose price constant to internal code
      const PRICE_PER_NIGHT_INTERNAL = PRICE_PER_NIGHT || PRICE_PER_NIGHT; // avoid linter warning
      // debugging fallback
      window._booking_debug = { PRICE_PER_NIGHT };

    })();

    //set
    let isAvailable = false; // tracks whether villa is available

    document.addEventListener("DOMContentLoaded", function () {
      const checkBtn = document.getElementById("checkAvailabilityBtn");
      const msgEl = document.getElementById("availabilityMsg");
      const dateInput = document.getElementById("dateRange");

      checkBtn.addEventListener("click", async () => {
        const dateRange = dateInput.value;
        if (!dateRange || !dateRange.includes(" to ")) {
          msgEl.textContent = "⚠️ Please select valid dates first.";
          msgEl.style.color = "orange";
          isAvailable = false;
          return;
        }

        const [checkIn, checkOut] = dateRange.split(" to ").map((d) => d.trim());

        try {
          const res = await fetch(`/listings/<%= listing._id %>/check-availability?checkIn=${checkIn}&checkOut=${checkOut}`);
          const data = await res.json();

          msgEl.textContent = data.message;
          msgEl.style.color = data.available ? "green" : "red";

          isAvailable = data.available; // 🔹 store availability state globally

          // disable/enable confirm button
          const confirmBtn = document.querySelector("form button[type='submit']");
          if (confirmBtn) confirmBtn.disabled = !data.available;

        } catch (err) {
          msgEl.textContent = "Server error checking availability.";
          msgEl.style.color = "red";
          isAvailable = false;
        }
      });

    });

    document.addEventListener("DOMContentLoaded", function () {
      const form = document.getElementById("bookingForm");
      const confirmBtn = document.getElementById("confirmBookingBtn");

      if (!form || !confirmBtn) return;

      confirmBtn.addEventListener("click", function (e) {
        e.preventDefault(); // Stop instant submission

        // --- Collect data for receipt ---
        const summary = document.getElementById("summaryContent")?.innerHTML || "No summary available";
        const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked')?.value || "N/A";
        const username = "<%= currUser?.username || 'Guest' %>"; // <-- from session
        const villaName = "<%= listing.title %>";
        const currentDate = new Date().toLocaleString();

        // --- Build HTML for receipt ---
        const receiptHTML = `
      <div style="font-family:Arial,sans-serif; padding:20px; max-width:600px;">
        <h2 style="text-align:center;">🏡 Villa Booking Receipt</h2>
        <h4 style="text-align:center;">${villaName}</h4>
        <p style="text-align:center; color:gray;">${currentDate}</p>
        <hr>
        <p><strong>Booked By:</strong> ${username}</p>
        ${summary}
        <p><strong>Payment Method:</strong> ${paymentMethod}</p>
        <p style="text-align:center;margin-top:30px;">✅ Thank you for booking with us!</p>
      </div>
    `;

        // --- Generate PDF Receipt ---
        const tempEl = document.createElement("div");
        tempEl.innerHTML = receiptHTML;

        html2pdf()
          .from(tempEl)
          .set({
            margin: 10,
            filename: `${username}_Villa_Booking_Receipt.pdf`,
            html2canvas: { scale: 2 },
            jsPDF: { orientation: "portrait" },
          })
          .save()
          .then(() => {
            // After PDF saved, submit the form
            form.submit();

            // Show success popup
            showSuccessPopup();
          })
          .catch(err => {
            console.error("PDF error:", err);
            form.submit();
          });
      });

      // --- Simple success popup function ---
      function showSuccessPopup() {
        const popup = document.createElement("div");
        popup.innerHTML = `
      <div style="
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        padding: 30px 40px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.3);
        border-radius: 15px;
        text-align: center;
        z-index: 9999;
      ">
        <h4 style="color:green;">🎉 Booking Successful!</h4>
        <p>Your villa has been booked successfully.</p>
        <button id="okBtn" style="
          background-color:#007bff;
          color:white;
          border:none;
          padding:8px 15px;
          border-radius:8px;
          cursor:pointer;
        ">OK</button>
      </div>
      <div id="overlay" style="
        position: fixed;
        top:0; left:0;
        width:100%; height:100%;
        background:rgba(0,0,0,0.3);
        z-index:9998;
      "></div>
    `;
        document.body.appendChild(popup);

        document.getElementById("okBtn").addEventListener("click", () => {
          popup.remove();
          document.getElementById("overlay")?.remove();
        });

      }
    });

  </script>