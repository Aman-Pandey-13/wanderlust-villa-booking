<% layout("/layout/boilerplate") -%>
  <!-- <script>
        const mapToken = 
    </script> -->
  <style>
    .weather-card {
      background: linear-gradient(135deg, #74ABE2, #5563DE);
      color: black;
    }

    .weather-card h4 {
      font-weight: 600;
      letter-spacing: 0.5px;
    }

    .forecast-day {
      transition: transform 0.2s ease-in-out;
      color: black;
    }

    .forecast-day:hover {
      transform: scale(1.05);
      background-color: rgba(255, 255, 255, 0.15);
    }
  </style>

  <div class="row mt-3">
    <div class="col-8 offset-3">
      <h3>
        <%= Listing.title %>
      </h3>
    </div>


    <!-- <div class="container mt-4"> -->
    <div class="row g-2">
      <!-- Big left image -->
      <div class="col-md-6">
        <img src="<%= Listing.images[0].url %>" alt="Main" class="img-fluid rounded w-100 h-100"
          style="object-fit: cover; max-height: 500px;">
      </div>


      <!-- 4 smaller images -->
      <div class="col-md-6">
        <div class="row g-2">
          <% Listing.images.slice(1,5).forEach(img=> { %>
            <div class="col-6">
              <img src="<%= img.url %>" alt="Gallery" class="img-fluid rounded w-100"
                style="object-fit: cover; height: 245px;">
            </div>
            <% }) %>
        </div>
      </div>
    </div>
  </div>

  <!-- </div> -->



  <div class="card-body">
    <p>
      <i>
        Owned By:
        <%= Listing.owner ? Listing.owner.username : "Unknown" %>
      </i>
    </p>

    <%= Listing.description %> <br>
      &#8377;<%= Listing.price.toLocaleString("en-IN") %> <br>
        <%= Listing.location %> <br>
          <%= Listing.country %>
  </div>
  </div>


  <!-- Centered Book Now button -->
  <div class="text-center my-4">
    <% if (currUser) { %>
      <a href="/listings/<%= Listing._id %>/book" class="btn btn-primary btn-lg">
        Book Now
      </a>
      <% } else { %>
        <p class="text-muted">
          Please <a href="/login" class="btn btn-outline-primary btn-sm">Log In</a> to book this villa.
        </p>
        <% } %>
  </div>
  </div>
  <!-- 🌤️ Weather Info Section -->
  <div class="container my-4">
    <div class="card shadow-lg border-0 rounded-4 weather-card mx-auto" style="max-width: 100%;">
      <div class="card-body text-center">
        <h4 class="card-title mb-3">🌤 Current Weather</h4>
        <div id="weatherInfo" class="d-flex justify-content-center align-items-center mb-3"></div>
        <div id="forecast" class="d-flex justify-content-between text-center"></div>
      </div>
    </div>
  </div>


  <% if (currUser && Listing.owner && currUser._id.toString()===Listing.owner._id.toString()) { %>
    <div class="btns">
      <a href="/listings/<%= Listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit-btn">Edit</a>
      <form method="post" action="/listings/<%= Listing._id %>?_method=DELETE">
        <button class="btn btn-dark offset-5">DELETE</button>
      </form>
    </div>
    <% } %>

      <!-- Review page -->
      <div class="col-8 offset-3 mb-3">
        <% if (currUser) { %>
          <hr>
          <h4>Leave A Review</h4>
          <form action="/listings/<%= Listing.id %>/reviews" method="post" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
              <label for="rating" class="form-label">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked
                  aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3 mt-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea name="review[comment]" id="comment" class="form-control" cols="30" rows="5" required></textarea>
              <div class="invalid-feedback">
                Please add some Comment for review
              </div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
          </form>
          <% } %>

            <hr>

            <% if (Listing.reviews.length> 0) { %>
              <div class="row">
                <p><b>ALL Reviews</b></p>
                <% for (let review of Listing.reviews) { %>
                  <div class="card col-5 ms-3 mb-3">
                    <div class="card-body">
                      <h5 class="card-title">@<%= review.author.username %>
                      </h5>
                      <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                      <p class="card-text">
                        <%= review.comment %>
                      </p>

                      <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                        <form class="mb-3" method="post"
                          action="/listings/<%= Listing._id %>/reviews/<%= review.id %>?_method=DELETE">
                          <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                        <% } %>
                    </div>
                  </div>
                  <% } %>
              </div>
              <% } %>

      </div>

      <!-- Map Section -->
      <div class="col-8 offset-3 mb-3">
        <h3>Where You'll Be</h3>
        <!-- Store coordinates as data attribute -->
        <div id="map" style="height: 400px; border-radius: 10px;"
          data-lng="<%= Listing.geometry && Listing.geometry.coordinates ? Listing.geometry.coordinates[0] : 78.9629 %>"
          data-lat="<%= Listing.geometry && Listing.geometry.coordinates ? Listing.geometry.coordinates[1] : 20.5937 %>"
          data-title="<%= Listing.title %>" data-location="<%= Listing.location %>">
        </div>
      </div>


      <!-- Leaflet CSS & JS -->
      <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
      <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

      <script>
        const mapDiv = document.getElementById('map');
        const lat = parseFloat(mapDiv.dataset.lat);
        const lng = parseFloat(mapDiv.dataset.lng);
        const title = mapDiv.dataset.title;
        const mapLocation = mapDiv.dataset.location; // renamed

        const map = L.map('map').setView([lat, lng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        L.marker([lat, lng]).addTo(map)
          .bindPopup(`<b>${title}</b><br>${mapLocation}`)
          .openPopup();


        // Weather update  f5f0a969c28cac81a9243f6469a05548
        async function fetchWeather() {
          const apiKey = "f5f0a969c28cac81a9243f6469a05548"; // 🔑 Replace with your OpenWeatherMap API key
          const lat = `<%= Listing.geometry && Listing.geometry.coordinates ? Listing.geometry.coordinates[1] : 0 %>`;
          const lon = `<%= Listing.geometry && Listing.geometry.coordinates ? Listing.geometry.coordinates[0] : 0 %>`;
          const weatherDiv = document.getElementById("weatherInfo");
          const forecastDiv = document.getElementById("forecast");

          try {
            // 🌡️ Current weather
            const currentRes = await fetch(
              `https://api.openweathermap.org/data/2.5/weather?lat=${lat}&lon=${lon}&appid=${apiKey}&units=metric`
            );
            const currentData = await currentRes.json();

            if (currentData.cod === 200) {
              const temp = currentData.main.temp.toFixed(1);
              const condition = currentData.weather[0].description;
              const icon = currentData.weather[0].icon;
              const city = currentData.name;

              weatherDiv.innerHTML = `
        <div class="d-flex align-items-center justify-content-center">
          <img src="https://openweathermap.org/img/wn/${icon}@2x.png" alt="${condition}" class="me-3" style="width:70px;">
          <div>
            <h2 class="fw-bold mb-0">${temp}°C</h2>
            <p class="mb-1 text-capitalize">${condition}</p>
            <small class="text-muted">${city}</small>
          </div>
        </div>
      `;
            } else {
              weatherDiv.innerHTML = `<p class="text-danger">Weather info not available.</p>`;
            }

            // 🌤 3-day forecast
            const forecastRes = await fetch(
              `https://api.openweathermap.org/data/2.5/forecast?lat=${lat}&lon=${lon}&appid=${apiKey}&units=metric`
            );
            const forecastData = await forecastRes.json();

            if (forecastData.cod === "200") {
              forecastDiv.innerHTML = "";
              const daily = forecastData.list.filter((item) => item.dt_txt.includes("12:00:00"));
              daily.slice(0, 3).forEach((day) => {
                const date = new Date(day.dt_txt);
                const options = { weekday: "short" };
                const dayName = date.toLocaleDateString("en-US", options);
                const temp = day.main.temp.toFixed(1);
                const icon = day.weather[0].icon;
                const desc = day.weather[0].main;

                forecastDiv.innerHTML += `
          <div class="p-2 flex-fill bg-light rounded-3 shadow-sm mx-1 forecast-day">
            <p class="fw-semibold mb-1">${dayName}</p>
            <img src="https://openweathermap.org/img/wn/${icon}.png" alt="${desc}" style="width:50px;">
            <p class="mb-0">${temp}°C</p>
          </div>
        `;
              });
            }
          } catch (err) {
            console.error(err);
            weatherDiv.innerHTML = `<p class="text-danger">Error fetching weather data.</p>`;
          }
        }

        fetchWeather();
      </script>