<% layout("/layout/boilerplate") -%>

    <div class="row mt-3">
        <div class="col-8 offset-2">
            

                            <h3>Create New Listing</h3>

                            <form id="listingForm" action="/listings" method="POST" enctype="multipart/form-data">
                                <!-- Title -->
                                <div class="mb-3">
                                    <label for="title" class="form-label">Title</label>
                                    <input type="text" id="title" name="listing[title]" placeholder="Enter title"
                                        class="form-control" required>
                                </div>

                                <!-- Description -->
                                <div class="mb-3">
                                    <label for="description" class="form-label">Description</label>
                                    <textarea id="description" name="listing[description]" rows="4" class="form-control"
                                        required></textarea>
                                </div>

                                <!-- Images -->
                                <div class="mb-3">
                                    <label class="form-label">Upload Images (Max 5)</label>
                                    <div id="imageInputs">
                                        <input type="file" name="listing[images]" accept="image/*"
                                            class="form-control mb-2 image-input" onchange="addNextImageInput(this)">
                                    </div>
                                    <div id="imagePreview" class="mt-3 d-flex flex-wrap"></div>
                                    <small class="text-muted" id="imageCountText">0 / 5 images uploaded</small>
                                </div>

                                <!-- Price -->
                                <div class="row">
                                    <div class="mb-3 col-md-4">
                                        <label for="price" class="form-label">Price</label>
                                        <input name="listing[price]" placeholder="Enter price" class="form-control"
                                            required>
                                    </div>
                                </div>

                                <!-- Address -->
                                <h5 class="mt-4 mb-2">Address Details</h5>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="street" class="form-label">Street / Building No.</label>
                                        <input type="text" id="street" class="form-control"
                                            placeholder="e.g., Bungalow No. 22">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label for="area" class="form-label">Area / Locality</label>
                                        <input type="text" id="area" class="form-control"
                                            placeholder="e.g., Bandra West">
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label for="city" class="form-label">City</label>
                                        <input type="text" id="city" class="form-control" placeholder="e.g., Mumbai">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="state" class="form-label">State</label>
                                        <input type="text" id="state" class="form-control"
                                            placeholder="e.g., Maharashtra">
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label for="country" class="form-label">Country</label>
                                        <input type="text" id="country" name="listing[country]" class="form-control"
                                            placeholder="e.g., India">
                                    </div>
                                </div>

                                <!-- Pincode -->
                                <div class="mb-3">
                                    <label for="pincode" class="form-label">Pincode</label>
                                    <input type="text" id="pincode" class="form-control" placeholder="e.g., 400050">
                                    <button type="button" id="verifyPincodeBtn"
                                        class="btn btn-sm btn-outline-primary mt-2">Verify Pincode</button>
                                    <small id="pincodeStatus" class="ms-2 text-muted"></small>
                                </div>

                                <!-- Map -->
                                <div class="mb-4">
                                    <label class="form-label">Map Preview</label>
                                    <div id="map" style="height:350px;border-radius:10px;"></div>
                                    <input type="hidden" name="listing[lat]" id="latField">
                                    <input type="hidden" name="listing[lng]" id="lngField">
                                    <input type="hidden" name="listing[location]" id="locationField">
                                </div>

                                <button class="btn btn-dark w-100 mt-3">Add Listing</button>
                            </form>
        </div>
    </div>

    <!-- Leaflet JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>
        const MAX_IMAGES = 5;
        const map = L.map('map').setView([20.5937, 78.9629], 4);
        let marker;

        function addNextImageInput(currentInput) {
            const container = document.getElementById('imageInputs');
            const previewContainer = document.getElementById('imagePreview');
            const uploadedCount = previewContainer.querySelectorAll('img').length;

            if (uploadedCount >= MAX_IMAGES) {
                alert("You can only upload up to 5 images.");
                currentInput.value = "";
                return;
            }

            if (currentInput.files && currentInput.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const imgContainer = document.createElement('div');
                    imgContainer.classList.add('position-relative', 'me-2', 'mb-2');
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.style.width = "120px";
                    img.style.height = "100px";
                    img.style.objectFit = "cover";
                    img.classList.add('rounded');
                    const removeBtn = document.createElement('button');
                    removeBtn.textContent = "×";
                    removeBtn.classList.add('btn', 'btn-sm', 'btn-danger', 'position-absolute', 'top-0', 'end-0', 'translate-middle');
                    removeBtn.onclick = function () { imgContainer.remove(); updateImageCount(); };
                    imgContainer.appendChild(img);
                    imgContainer.appendChild(removeBtn);
                    previewContainer.appendChild(imgContainer);
                    updateImageCount();
                };
                reader.readAsDataURL(currentInput.files[0]);
            }

            if (previewContainer.querySelectorAll('img').length < MAX_IMAGES) {
                const newInput = document.createElement('input');
                newInput.type = 'file';
                newInput.name = 'listing[images]';
                newInput.accept = 'image/*';
                newInput.classList.add('form-control', 'mb-2', 'image-input');
                newInput.onchange = function () { addNextImageInput(newInput); };
                container.appendChild(newInput);
            }
        }

        function updateImageCount() {
            const countText = document.getElementById('imageCountText');
            const previewContainer = document.getElementById('imagePreview');
            countText.textContent = `${previewContainer.querySelectorAll('img').length} / ${MAX_IMAGES} images uploaded`;
        }

        function updateMap() {
            const street = document.getElementById("street").value.trim();
            const area = document.getElementById("area").value.trim();
            const city = document.getElementById("city").value.trim();
            const state = document.getElementById("state").value.trim();
            const country = document.getElementById("country").value.trim();
            const pincode = document.getElementById("pincode").value.trim();

            const fullAddress = [street, area, city, state, country, pincode].filter(Boolean).join(", ");
            document.getElementById("locationField").value = fullAddress;
            if (!fullAddress) return;

            fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(fullAddress)}`)
                .then(res => res.json())
                .then(data => {
                    if (data.length > 0) {
                        const lat = parseFloat(data[0].lat);
                        const lon = parseFloat(data[0].lon);
                        document.getElementById("latField").value = lat;
                        document.getElementById("lngField").value = lon;
                        if (marker) marker.remove();
                        marker = L.marker([lat, lon]).addTo(map);
                        map.setView([lat, lon], 15);
                    }
                })
                .catch(err => console.error(err));
        }

        ["street", "area", "city", "state", "country", "pincode"].forEach(id => {
            const el = document.getElementById(id);
            el.addEventListener("change", updateMap);
            el.addEventListener("keyup", updateMap);
        });

        document.getElementById("verifyPincodeBtn").addEventListener("click", async () => {
            const pin = document.getElementById("pincode").value.trim();
            const status = document.getElementById("pincodeStatus");
            if (!pin) { status.textContent = "Enter pincode"; return; }
            try {
                const res = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
                const data = await res.json();
                if (data[0].Status === "Success") {
                    status.textContent = `✅ Valid: ${data[0].PostOffice[0].District}, ${data[0].PostOffice[0].State}`;
                    status.classList.add("text-success");
                } else {
                    status.textContent = "❌ Invalid Pincode";
                    status.classList.add("text-danger");
                }
            } catch (err) { status.textContent = "Error verifying pincode"; }
        });

        // ✅ Prevent submitting without a location
        document.getElementById("listingForm").addEventListener("submit", (e) => {
            const loc = document.getElementById("locationField").value.trim();
            if (!loc) {
                e.preventDefault();
                alert("⚠️ Please fill in your address details to set a location before submitting.");
                return false;
            }
        });
    </script>